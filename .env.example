# S3 target bucket
S3_BUCKET=your-bucket-name

# "s3" or "local" (local writes to data/ folder, no AWS needed)
STORAGE_BACKEND=local

# Local output dir (used when STORAGE_BACKEND=local)
LOCAL_DATA_DIR=data

# Path to the Spotify CSV file
SOURCE_CSV=dataset.csv

# Override run date (default: today). Format: YYYY-MM-DD
# RUN_DATE=2024-01-01
